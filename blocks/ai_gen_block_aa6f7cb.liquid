    { "type": "text", "id": "event_3_title", "label": "Event name", "default": "Mom Church" },
    { "type": "text", "id": "event_3_date", "label": "Date and time", "default": "November 15" },
    { "type": "richtext", "id": "event_3_details", "label": "Details", "default": "<p>Gather with us for Mom Church.</p>" },
    { "type": "text", "id": "event_3_location", "label": "Location", "default": "The Pearl" },
    { "type": "image_picker", "id": "event_3_flyer", "label": "Event flyer" },
    { "type": "header", "content": "Event 4" },
    { "type": "text", "id": "event_4_title", "label": "Event name", "default": "Grand Opening" },
    { "type": "text", "id": "event_4_date", "label": "Date and time", "default": "December 4" },
    { "type": "richtext", "id": "event_4_details", "label": "Details", "default": "<p>Celebrate our grand opening with us.</p>" },
    { "type": "text", "id": "event_4_location", "label": "Location", "default": "The Pearl" },
    { "type": "image_picker", "id": "event_4_flyer", "label": "Event flyer" },
    { "type": "header", "content": "Event 5" },
    { "type": "text", "id": "event_5_title", "label": "Event name", "default": "Victorian Christmas hours" },
    { "type": "text", "id": "event_5_date", "label": "Date and time", "default": "Dec 6, 9, 13, 16, and 20" },
    { "type": "richtext", "id": "event_5_details", "label": "Details", "default": "<p>Sundays, December 6, 13, and 20: 1:30–6 PM. Wednesdays, December 9 and 16: 5–9 PM.</p>" },
    { "type": "text", "id": "event_5_location", "label": "Location", "default": "The Pearl" },
    { "type": "image_picker", "id": "event_5_flyer", "label": "Event flyer" },
    { "type": "header", "content": "Event 6" },
