{%- doc -%}
  Renders the control that returns a visitor to the top of the page.

  It is a plain anchor rather than a scripted button: base.css already sets
  `scroll-behavior: smooth` on the document, so the scroll animates without any
  JavaScript and the control keeps working for keyboard and no-JS visitors.

  The target is `#MainContent`, the `<main>` rendered by layout/theme.liquid —
  the same element the theme's own skip link points at. It deliberately does not
  point at `#header-group`: with a sticky header, sections/header.liquid gives
  that element `display: contents`, so it generates no box to scroll to.

  Appearance (the gold gradient, size and placement) lives in
  assets/global-css.css, since a gradient cannot be expressed as a theme setting.
{%- enddoc -%}

<a
  class="back-to-top"
  href="#MainContent"
  aria-label="{{ 'accessibility.back_to_top' | t }}"
  {{ block.shopify_attributes }}
>
  <span
    class="back-to-top__icon"
    aria-hidden="true"
  >
    {{- 'icon-chevron-up.svg' | inline_asset_content -}}
  </span>
</a>

{% stylesheet %}
  .back-to-top {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-to-top__icon {
    display: flex;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Back to top",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Back to top"
    }
  ]
}
{% endschema %}
