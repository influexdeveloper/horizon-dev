

{% liquid
  assign font_family = block.settings.font
  if block.settings.font == 'custom' and block.settings.custom_font_family != blank
    assign font_family = block.settings.custom_font_family
  endif
  assign has_custom_font = false
  if font_family != blank and font_family != 'custom'
    assign has_custom_font = true
  endif
%}

<div
  class="custom-liquid-block {{ block.settings.custom_class }} {% if has_custom_font %}custom-liquid-block--custom-font{% endif %}"
  {% if has_custom_font %}
    style="--font-family: {{ font_family }};"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.custom_liquid }}
</div>

{% stylesheet %}
  .custom-liquid-block--custom-font,
  .custom-liquid-block--custom-font * {
    font-family: var(--font-family);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "info": "Adds this class to the block's wrapper, e.g. \"text-gradient\"."
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "custom_font_family",
      "label": "Custom font family",
      "info": "Enter a CSS font-family value, e.g. \"Georgia, serif\".",
      "visible_if": "{{ block.settings.font == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
