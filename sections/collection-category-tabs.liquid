

<div
  class="section section--{{ section.settings.section_width }} collection-category-tabs spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <ul class="collection-category-tabs__list" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign tab_link = block.settings.link
        assign is_active = false
        if tab_link != blank and tab_link == request.path
          assign is_active = true
        elsif tab_link == blank and block.settings.default_tab
          assign is_active = true
        endif
      %}
      <li class="collection-category-tabs__item" {{ block.shopify_attributes }}>
        <a
          href="{{ tab_link | default: collection.url }}"
          class="collection-category-tabs__link{% if is_active %} collection-category-tabs__link--active{% endif %}"
        >
          {{ block.settings.label }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .collection-category-tabs {
    display: flex;
  }

  .collection-category-tabs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .collection-category-tabs__link {
    display: inline-block;
    padding-block-end: 6px;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    border-block-end: 1px solid transparent;
    transition: color var(--duration-short) ease, border-color var(--duration-short) ease;
  }

  .collection-category-tabs__link:hover {
    color: var(--color-foreground);
  }

  .collection-category-tabs__link--active {
    color: var(--collection-category-tabs-active-color, #4d0804);
    border-block-end-color: var(--collection-category-tabs-active-color, #4d0804);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tabs",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "default_tab",
          "label": "Active when no link is set",
          "info": "Use for a tab (e.g. \"All\") that should appear active whenever none of the other tabs' links match the current page.",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Category tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "All", "default_tab": true } },
        { "type": "tab", "settings": { "label": "Tinctures" } },
        { "type": "tab", "settings": { "label": "Teas" } },
        { "type": "tab", "settings": { "label": "Skincare" } },
        { "type": "tab", "settings": { "label": "Balms" } }
      ]
    }
  ]
}
{% endschema %}
