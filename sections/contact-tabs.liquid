

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% comment %}
  No `{% form 'contact' %}` here on purpose: every panel below is a plain
  `<form>` that contact-tabs.js submits entirely client-side, straight to
  Klaviyo's public Client API — there is no Shopify-side processing, no
  redirect, and no store notification email for any of the three tabs.
  Success/error UI (below) is JS-driven for the same reason: it clones the
  matching `<template>` in that panel rather than reacting to a `form` drop,
  since there's no server round trip left to populate one.
{% endcomment %}
{% assign active_block_id = section.blocks.first.id %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<contact-tabs
  class="
    contact-tabs section section--{{ section.settings.section_width }} spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.section_width == 'custom' and section.settings.section_width_custom != blank %}
      --section-width-custom: {{ section.settings.section_width_custom | remove: 'px' | strip }}px;
    {% endif %}
    --contact-tabs-card-background: {{ section.settings.card_background_color }};
    --contact-tabs-input-border: {{ section.settings.input_border_color }};
    --contact-tabs-active-color: {{ section.settings.active_tab_text_color }};
    --contact-tabs-inactive-color: {{ section.settings.inactive_tab_text_color }};
  "
  data-testid="contact-tabs"
  data-klaviyo-public-key="{{ section.settings.klaviyo_public_api_key }}"
>
 <div class="contact-tabs__container">
  <div
    class="contact-tabs__tablist"
    role="tablist"
  >
    {% for block in section.blocks %}
      {% assign is_active = false %}
      {% if block.id == active_block_id %}
        {% assign is_active = true %}
      {% endif %}
      <button
        type="button"
        role="tab"
        id="ContactTab-{{ block.id }}"
        aria-controls="ContactPanel-{{ block.id }}"
        aria-selected="{{ is_active }}"
        class="contact-tabs__tab{% if is_active %} contact-tabs__tab--active{% endif %}"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.label }}
      </button>
    {% endfor %}
  </div>

  <div class="contact-tabs__panels">
    {% for block in section.blocks %}
      {% assign is_active = false %}
      {% if block.id == active_block_id %}
        {% assign is_active = true %}
      {% endif %}
      {% capture success_message_html %}
        {% case block.type %}
          {% when 'signup_panel' %}
            <p class="h4">SUBSCRIPTION CONFIRMED</p>
          {% else %}
            <p class="h4">Thank you for contacting us.</p>
            <p>We will be in touch with you shortly.</p>
        {% endcase %}
      {% endcapture %}
      <div
        id="ContactPanel-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="ContactTab-{{ block.id }}"
        class="contact-tabs__panel{% if is_active %} contact-tabs__panel--active{% endif %}"
        {% unless is_active %}
          hidden
        {% endunless %}
      >
        <form
          class="contact-tabs__form"
          data-klaviyo-list-id="{{ block.settings.klaviyo_list_id }}"
          novalidate
        >
          {% comment %}
            Honeypot: real visitors never see or reach this field (visually
            hidden, aria-hidden, and skipped by keyboard tabbing), but simple
            spam bots that auto-fill every input they find tend to fill it
            in. contact-tabs.js drops the submission client-side when it's
            non-empty — see #handleFormSubmit.
          {% endcomment %}
          <div
            class="contact-tabs__honeypot"
            aria-hidden="true"
          >
            <label for="ContactTabs-{{ block.id }}-website">Website</label>
            <input
              type="text"
              id="ContactTabs-{{ block.id }}-website"
              data-klaviyo-honeypot
              tabindex="-1"
              autocomplete="off"
            >
          </div>

          {% if block.settings.intro_text != blank %}
            <p class="contact-tabs__intro">{{ block.settings.intro_text }}</p>
          {% endif %}

          {% case block.type %}
            {% when 'signup_panel' %}
              <div class="contact-tabs__row">
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
                  <input
                    type="text"
                    id="ContactTabs-{{ block.id }}-name"
                    class="contact-tabs__input"
                    autocomplete="name"
                    data-klaviyo-field="first_name"
                  >
                </div>
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-email">
                    {{- 'blocks.contact_form.email' | t -}}
                    <span aria-hidden="true">*</span>
                  </label>
                  <input
                    type="email"
                    id="ContactTabs-{{ block.id }}-email"
                    class="contact-tabs__input"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    required
                    data-klaviyo-email
                  >
                </div>
              </div>

            {% when 'wholesale_panel' %}
              <div class="contact-tabs__row">
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
                  <input
                    type="text"
                    id="ContactTabs-{{ block.id }}-name"
                    class="contact-tabs__input"
                    autocomplete="name"
                    data-klaviyo-field="first_name"
                  >
                </div>
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-email">
                    {{- 'blocks.contact_form.email' | t -}}
                    <span aria-hidden="true">*</span>
                  </label>
                  <input
                    type="email"
                    id="ContactTabs-{{ block.id }}-email"
                    class="contact-tabs__input"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    required
                    data-klaviyo-email
                  >
                </div>
              </div>
              <div class="contact-tabs__row">
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-phone">{{ 'blocks.contact_form.phone' | t }}</label>
                  <input
                    type="tel"
                    id="ContactTabs-{{ block.id }}-phone"
                    class="contact-tabs__input"
                    autocomplete="tel"
                    pattern="[0-9\-]*"
                    data-klaviyo-field="phone_number"
                  >
                </div>
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-event-date">Event Date</label>
                  <input
                    type="text"
                    id="ContactTabs-{{ block.id }}-event-date"
                    class="contact-tabs__input"
                    data-klaviyo-field="Event Date"
                  >
                </div>
              </div>
              <div class="contact-tabs__row">
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-business-name">Business Name</label>
                  <input
                    type="text"
                    id="ContactTabs-{{ block.id }}-business-name"
                    class="contact-tabs__input"
                    data-klaviyo-field="Business Name"
                  >
                </div>
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-location">Location</label>
                  <input
                    type="text"
                    id="ContactTabs-{{ block.id }}-location"
                    class="contact-tabs__input"
                    data-klaviyo-field="Location"
                  >
                </div>
              </div>
              <div class="contact-tabs__field contact-tabs__field--full">
                <label for="ContactTabs-{{ block.id }}-body">Inquiry details</label>
                <textarea
                  rows="4"
                  id="ContactTabs-{{ block.id }}-body"
                  class="contact-tabs__input contact-tabs__input--textarea"
                  data-klaviyo-field="Inquiry details"
                ></textarea>
              </div>

            {% when 'general_panel' %}
              <div class="contact-tabs__row">
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
                  <input
                    type="text"
                    id="ContactTabs-{{ block.id }}-name"
                    class="contact-tabs__input"
                    autocomplete="name"
                    data-klaviyo-field="first_name"
                  >
                </div>
                <div class="contact-tabs__field">
                  <label for="ContactTabs-{{ block.id }}-email">
                    {{- 'blocks.contact_form.email' | t -}}
                    <span aria-hidden="true">*</span>
                  </label>
                  <input
                    type="email"
                    id="ContactTabs-{{ block.id }}-email"
                    class="contact-tabs__input"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    required
                    data-klaviyo-email
                  >
                </div>
              </div>
              <div class="contact-tabs__field contact-tabs__field--full">
                <label for="ContactTabs-{{ block.id }}-body">Message</label>
                <textarea
                  rows="4"
                  id="ContactTabs-{{ block.id }}-body"
                  class="contact-tabs__input contact-tabs__input--textarea"
                  data-klaviyo-field="Message"
                ></textarea>
              </div>
          {% endcase %}

          <button
            type="submit"
            class="button contact-tabs__submit"
          >
            {{- block.settings.button_label -}}
          </button>
        </form>

        <template class="contact-tabs__success-template">
          <div
            class="contact-form__success"
            tabindex="-1"
          >
            {{ success_message_html }}
          </div>
        </template>
        <template class="contact-tabs__error-template">
          <div
            class="contact-form__error"
            tabindex="-1"
          >
            {{- 'icon-error.svg' | inline_asset_content -}}
            <p>Something went wrong. Please try again.</p>
          </div>
        </template>
      </div>
    {% endfor %}
  </div>
 </div>
</contact-tabs>

{% stylesheet %}
  .contact-tabs__container {
    display: flex;
    flex-direction: column;
  }

  .contact-tabs__tablist {
    display: flex;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-tabs__tab {
    flex: 1 1 0;
    padding: 12px 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    line-height: 1.2;
    text-align: center;
    color: var(--contact-tabs-inactive-color, #bababa);
    transition: color var(--duration-short) ease, background-color var(--duration-short) ease;

    @media screen and (min-width: 750px) {
      padding: 20px 16px;
      font-size: 1.125rem;
    }
  }

  .contact-tabs__tab--active {
    background-color: var(--contact-tabs-card-background, #fff);
    color: var(--contact-tabs-active-color, #4d0804);
  }

  .contact-tabs__panels {
    background-color: var(--contact-tabs-card-background, #fff);
  }

  .contact-tabs__panel {
    padding: 20px;

    @media screen and (min-width: 750px) {
      padding: 32px;
    }
  }

  .contact-tabs__intro {
    margin: 0 0 24px;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.3;
  }

  .contact-tabs__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 16px);
  }

  /* `[hidden]` alone ties `.contact-tabs__form`'s own `display: flex` on
     specificity, and the class wins that tie — contact-tabs.js's
     `form.hidden = true` on success would otherwise leave the form (submit
     button included) fully visible, right above the success message. */
  .contact-tabs__form[hidden] {
    display: none;
  }

  .contact-tabs__row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 16px);

    @media screen and (min-width: 750px) {
      flex-direction: row;
    }
  }

  .contact-tabs__field {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-body--family);
    font-weight: 300;
  }

  .contact-tabs__field--full {
    flex: 1 1 100%;
  }

  /* Off-screen rather than `display: none` or `hidden` — some spam bots skip
     fields that are display:none, but this still reads as an ordinary,
     fillable text input to them while staying invisible and unreachable
     (tabindex="-1" above) for real visitors and screen readers. */
  .contact-tabs__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* base.css's own `input:not([type='checkbox'], [type='radio'])` rule
     (one element + one attribute selector) outranks a single class, so it
     wins the border-color right back off a plain `.contact-tabs__input`
     rule regardless of load order. The doubled class is this codebase's own
     idiom for outranking a rule like that without `!important`.

     `color` is a literal value rather than `var(--color-input-text)`: that
     token resolves to this store's global foreground (white — the site's
     inputs otherwise sit on dark backgrounds), which is invisible against
     this card's own white background. */
  .contact-tabs__input.contact-tabs__input {
    width: 100%;
    color: #220706;
    background-color: var(--color-input-background);
    padding: var(--padding-lg, 12px) var(--padding-xl, 16px);
    border: 1px solid var(--contact-tabs-input-border, var(--color-input-border));
    border-radius: 0;
    font-family: var(--font-body--family);
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }

  .contact-tabs__input--textarea {
    resize: vertical;
    min-height: 96px;
  }

  .contact-tabs__submit {
    width: 100%;
    margin-block-start: 8px;

    @media screen and (min-width: 750px) {
      width: auto;
      align-self: center;
    }
  }

  .contact-form__error {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 8px);
    margin-block-end: 16px;
  }

  .contact-form__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-block-start: 16px;
    padding: 24px;
    border: 1px solid var(--contact-tabs-input-border, var(--color-input-border));
    text-align: center;
  }

  .contact-form__success p.h4 {
    margin-block-end: 10px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact tabs",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "signup_panel",
      "name": "Email sign up",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Email Sign Up & Special Offers"
        },
        {
          "type": "textarea",
          "id": "intro_text",
          "label": "Intro text",
          "default": "Stay connected to the Monrosia community, discover new products, and learn about upcoming offerings."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Join The Ritual"
        },
        {
          "type": "header",
          "content": "Klaviyo"
        },
        {
          "type": "text",
          "id": "klaviyo_list_id",
          "label": "Klaviyo list ID",
          "info": "Subscribes the submitted email to this list. Leave blank to skip Klaviyo for this tab."
        }
      ]
    },
    {
      "type": "wholesale_panel",
      "name": "Wholesale",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Wholesale & Partnerships"
        },
        {
          "type": "textarea",
          "id": "intro_text",
          "label": "Intro text",
          "default": "Interested in carrying Monrosia products or offering The Red Lotus Tea Service at your space or event?"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Send Message"
        },
        {
          "type": "header",
          "content": "Klaviyo"
        },
        {
          "type": "text",
          "id": "klaviyo_list_id",
          "label": "Klaviyo list ID",
          "info": "Subscribes the submitted email to this list. Leave blank to skip Klaviyo for this tab."
        }
      ]
    },
    {
      "type": "general_panel",
      "name": "General inquiries",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "General Inquiries"
        },
        {
          "type": "textarea",
          "id": "intro_text",
          "label": "Intro text",
          "default": "For order questions, product guidance, or returns, please include your order number and the best way to reach you."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Send Message"
        },
        {
          "type": "header",
          "content": "Klaviyo"
        },
        {
          "type": "text",
          "id": "klaviyo_list_id",
          "label": "Klaviyo list ID",
          "info": "Subscribes the submitted email to this list. Leave blank to skip Klaviyo for this tab."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "text",
      "id": "section_width_custom",
      "label": "Custom width",
      "placeholder": "688",
      "default": "688",
      "visible_if": "{{ section.settings.section_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color",
      "default": "#f0d9bb"
    },
    {
      "type": "color",
      "id": "active_tab_text_color",
      "label": "Active tab color",
      "default": "#4d0804"
    },
    {
      "type": "color",
      "id": "inactive_tab_text_color",
      "label": "Inactive tab color",
      "default": "#bababa"
    },
    {
      "type": "header",
      "content": "Klaviyo"
    },
    {
      "type": "text",
      "id": "klaviyo_public_api_key",
      "label": "Klaviyo public API key",
      "info": "Your Klaviyo account's public API key (Settings > API Keys). Shared by every tab below — each tab's own \"Klaviyo list ID\" setting picks which list it subscribes to."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Contact tabs",
      "category": "Forms",
      "blocks": {
        "signup": {
          "type": "signup_panel"
        },
        "wholesale": {
          "type": "wholesale_panel"
        },
        "general": {
          "type": "general_panel"
        }
      },
      "block_order": ["signup", "wholesale", "general"]
    }
  ]
}
{% endschema %}
