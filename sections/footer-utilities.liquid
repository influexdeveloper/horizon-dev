

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  {{ section.shopify_attributes }}
>
  <div
    class="utilities utilities--blocks-{{ section.blocks.size }}{% if section.settings.show_image %} utilities--has-image{% endif %} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px;{% if section.settings.divider_color != blank %} --divider-color: {{ section.settings.divider_color }};{% endif %} --gap: {{ section.settings.gap }}px;"
    data-testid="footer-utilities"
  >
    {%- if section.settings.show_image -%}<div class="utilities__main">{%- endif -%}
    {% content_for 'blocks' %}
    {%- if section.settings.show_image -%}</div>{%- endif -%}
    {%- if section.settings.show_image -%}
      <div class="utilities__image" style="--image-width: {{ section.settings.image_width }}px;">
        {%- if section.settings.image_link != blank -%}
          <a href="{{ section.settings.image_link }}" class="utilities__image-link"{% if section.settings.image_link_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', alt: section.settings.image_alt, widths: '200, 400, 800', sizes: '(min-width: 750px) 300px, 50vw'
          }}
        {%- else -%}
          <img
            src="https://cdn.shopify.com/s/files/1/0775/4694/6797/files/influex-footer.png?v=1791351745"
            alt="{{ section.settings.image_alt | escape }}"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.image_link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .utilities {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap);
    text-wrap: nowrap;
    border-top: var(--border-width) solid var(--divider-color, var(--color-border));
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      justify-content: center;
      gap: var(--gap);
      align-items: center;
      text-align: left;
    }
  }

  .utilities a,
  .utilities button {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .utilities > * {
    text-align: center;

    @media screen and (min-width: 750px) {
      text-align: left;
      justify-self: start;
    }
  }

  .utilities__image-link {
    display: block;
  }

  .utilities__image img {
    display: block;
    width: min(100%, var(--image-width, 160px));
    height: auto;
    margin-inline: auto;
  }

  /* Optional image: two columns on desktop (blocks left, image right), stacked and centred on mobile */
  .utilities__main {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    row-gap: 8px;
    text-align: center;
  }

  .utilities__main > * {
    text-align: center;
  }

  .utilities--has-image > .utilities__image {
    justify-self: center;
    text-align: center;
  }

  /* Below 990px (mobile and tablet) the bar stacks and centres */
  @media screen and (max-width: 989px) {
    .footer-utilities .utilities.utilities--has-image {
      flex-direction: column;
      justify-content: center;
      row-gap: 8px;
    }

    .utilities__main .menu .details-content ul {
      justify-content: center;
    }

    .utilities__main .menu .menu__item:first-child::before {
      content: none;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-utilities .utilities.utilities--has-image {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      column-gap: var(--gap);
    }

    .utilities--has-image > .utilities__main {
      flex: 0 0 auto;
    }

    .utilities--has-image > .utilities__image {
      flex: 1 1 0;
      min-width: 0;
    }

    .utilities__main {
      flex-direction: row;
      flex-wrap: nowrap;
      white-space: nowrap;
      justify-content: flex-start;
      column-gap: 0;
      row-gap: 0;
      text-align: left;
    }

    .utilities__main > * {
      text-align: left;
    }

    .utilities--has-image > .utilities__image {
      justify-self: end;
      text-align: right;
    }

    .utilities__main .menu .details-content ul {
      flex-wrap: nowrap;
    }

    .utilities__image img {
      margin-inline: auto 0;
    }
  }

  /* Dynamic positioning based on number of blocks */
  @media screen and (min-width: 750px) {
    /* 1 block: Single column, left aligned */
    .utilities--blocks-1 {
      grid-template-columns: 1fr;
      justify-content: start;
    }

    .utilities--blocks-1 > * {
      justify-self: start;
      text-align: left;
    }

    /* 2 blocks: Two equal columns, start and end aligned */
    .utilities--blocks-2 {
      grid-template-columns: 1fr 1fr;
    }

    .utilities--blocks-2 > *:nth-child(2) {
      justify-self: end;
      text-align: right;
    }

    /* 3 blocks: Three columns (1fr auto 1fr), start/center/end aligned */
    .utilities--blocks-3 {
      grid-template-columns: 1fr auto 1fr;
    }

    .utilities--blocks-3 > *:nth-child(2) {
      justify-self: center;
      text-align: center;
    }

    .utilities--blocks-3 > *:nth-child(3) {
      justify-self: end;
      text-align: right;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "Bottom right image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image in bottom right column",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the default Influex footer image.",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "image_link_new_tab",
      "label": "Open link in new tab",
      "default": false,
      "visible_if": "{{ section.settings.show_image and section.settings.image_link != blank }}"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Influex",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 40,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 160,
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "visible_if": "{{ section.settings.divider_thickness > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-list"
    },
    {
      "type": "social-links"
    },
    {
      "type": "menu"
    },
    {
      "type": "back-to-top"
    }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",
      "blocks": {
        "copyright": {
          "type": "footer-copyright"
        },
        "policy_list": {
          "type": "footer-policy-list"
        },
        "social_icons": {
          "type": "social-links"
        }
      },
      "block_order": ["copyright", "policy_list", "social_icons"]
    }
  ]
}
{% endschema %}
