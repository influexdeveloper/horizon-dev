              },
              "blocks": {}
            },
            "text_qqJUwV": {
              "type": "text",
              "name": "Text",
              "settings": {
                "text": "<p>I didn't yet understand that <strong>the deepest roots are not inherited.</strong></p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
