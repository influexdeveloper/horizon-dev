            "image_pQktW3": {
              "type": "image",
              "name": "t:names.image",
              "settings": {
                "image": "shopify://shop_images/IMG_4616_1.png",
                "link": "",
                "image_ratio": "adapt",
                "width": "fill",
                "custom_width": 100,
                "width_mobile": "fill",
                "custom_width_mobile": 100,
                "height": "fit",
