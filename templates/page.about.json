                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_6xXwwe": {
              "type": "text",
              "name": "Text",
              "settings": {
                "text": "<p><strong>The Red Lotus became more than a botanical.<br/>It became a teacher.</strong></p>",
