            "text_YiTCjP": {
              "type": "text",
              "name": "Text",
              "settings": {
                "text": "<p>Like many women, I spent years searching for belonging outside myself.</p><p>I believed fulfillment would come through achievement, through creating a beautiful life, through finding the right place or becoming the right version of myself. But beneath every accomplishment was a quieter longing.</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "text_color": "#220706",
                "custom_class": "",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "text_qc4JMj": {
              "type": "text",
              "name": "Text",
              "settings": {
                "text": "<h4>To feel rooted.<br/>To feel nourished.<br/>To feel at home.</h4>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-heading--family)",
                "font_size": "1.5rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
